{
  "name": "@vps-vault-sync/server",
  "version": "1.0.0",
  "description": "VPS daemon and WebSocket server for live bidirectional Obsidian vault syncing",
  "main": "dist/index.js",
  "bin": {
    "vps-vault-sync-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
