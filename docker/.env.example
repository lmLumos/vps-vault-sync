# ==============================================================================
# VPS Vault Sync - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your docker deployment directory:
#   cp .env.example .env
#
# IMPORTANT: Generate a strong random token for SYNC_TOKEN before starting.
# You can generate a secure token using:
#   openssl rand -hex 32
# ==============================================================================

# Required: Master secret token for authenticating Obsidian clients
SYNC_TOKEN=replace_with_your_strong_secret_token_here

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
VAULT_PATH=/data/vault

# Retention & File Limits
ARCHIVE_RETENTION_DAYS=30
MAX_FILE_SIZE_MB=100

# Obsidian Configuration Sync Preferences
SYNC_OBSIDIAN_CONFIG=true
SYNC_WORKSPACE=false

# Caddy Auto-HTTPS Configuration (used with docker-compose.caddy.yml)
DOMAIN=sync.yourdomain.com
EMAIL=admin@yourdomain.com

# Cloudflare Tunnel Configuration (used with cloudflare-tunnel example)
TUNNEL_TOKEN=
