{$DOMAIN:sync.yourdomain.com} {
    tls {$EMAIL:admin@yourdomain.com}

    # Reverse proxy HTTP API and WebSocket upgrade
    reverse_proxy sync-server:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output stdout
        format console
    }
}
